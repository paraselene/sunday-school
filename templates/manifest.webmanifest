{% load i18n static %}{% get_current_language as LANGUAGE_CODE %}{
  "id": "/",
  "name": "{% translate '主日學點名' %}",
  "short_name": "{% if LANGUAGE_CODE == 'en' %}Sunday School{% else %}主日學點名{% endif %}",
  "lang": "{{ LANGUAGE_CODE }}",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f4fa",
  "theme_color": "#5b2a86",
  "icons": [
    {"src": "{% static 'attendance/icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "{% static 'attendance/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}
